 $taskStrings[0]=$Executable;$taskStrings[1]=$taskRoot;$taskStrings[2]=$taskStageRoot;$taskStrings[3]=$taskTransportRoot
 for($taskI=0;$taskI -lt 8;$taskI++){$taskStrings[4+$taskI]=$Environment[$taskI]}
