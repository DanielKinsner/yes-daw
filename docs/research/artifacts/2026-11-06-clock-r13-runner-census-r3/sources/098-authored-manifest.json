  "Kahan_enclosure": {
    "unit_roundoff": "2^-53",
    "absolute_underflow": "denorm_min",
    "q": "OUTWARD(1+u),not plain1+u",
    "affine_coefficients_precomputed_once_M": true,
    "recurrence": [
      "A=q*(T+C)+delta",
      "ea=u*(T+C)+delta",
      "en=u*(S+A)+delta",
      "et=u*(A+en)+delta",
      "ec=u*(en+et)+delta",
      "Eprime=E+C+ea+en",
      "Cprime=en+et+ec",
      "Sprime=q*(S+A)+delta"
    ],
    "product_and_evaluation_errors_separate": true
  },
  "transform_derivation": {
    "cmul": "explicit4multiply2add,relative2*gamma3,absolute8delta",
    "complex_add": "relativeu,absolute2delta",
    "root_error": "actual certifiedMAXperplan,not table admission ceiling",
    "H": "(1+epsRoot)*(1+2*gamma3)",
