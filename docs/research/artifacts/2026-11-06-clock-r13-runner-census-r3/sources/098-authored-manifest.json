  "mathematical_contract": {
    "new_objective": "one fixed binary64 beta per trial from midpoint certifiedCZT RHS/centered analyticGram; computed one-passRSS uses SAMEbeta",
    "objective": "E-2*beta^T*b_B+beta^T*G_B*beta; NEVER E-beta^T*b",
    "basis_stats_bounds": {
      "pair": "M*(2*eps+eps^2)",
      "DC": "M*eps",
      "rhs": "eps*sumabs(y)",
      "DC_exact": true
    },
    "LS_accuracy": "G_B>=ellI,ell>M/4; excess<=norm(b_B-G_B*beta)^2/ell; require<=2^-32*energyLower before pruning every trial",
    "finalists": "all L_i<=min U_j; every finalist directly evaluated in increasingindex,strict< update",
