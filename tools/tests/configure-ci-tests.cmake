cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED CASE)
  if(NOT DEFINED TEST_ROOT OR EXISTS "${TEST_ROOT}")
    message(FATAL_ERROR "Supply a new TEST_ROOT to retain the regression receipts")
  endif()
  file(MAKE_DIRECTORY "${TEST_ROOT}")
  foreach(scenario hit outage timeout missing configure_failure)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${scenario}"
      "-DTEST_ROOT=${TEST_ROOT}" -P "${CMAKE_CURRENT_LIST_FILE}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${TEST_ROOT}/${scenario}.stdout.log" "${output}")
    file(WRITE "${TEST_ROOT}/${scenario}.stderr.log" "${error}")
    if(scenario STREQUAL "configure_failure")
      if(status STREQUAL "0" OR NOT error MATCHES "CI configuration failed: 7")
        message(FATAL_ERROR "A real configure failure was masked")
      endif()
    elseif(NOT status STREQUAL "0")
      message(FATAL_ERROR "${scenario}: ${output}\n${error}")
    endif()
  endforeach()
  message(STATUS "PASS five CI cache/configuration regression scenarios")
  return()
endif()

# Replace process execution only: run the actual configure helper and assert its
# complete compiler command, fallback decision and GitHub output on each path.
function(execute_process)
  cmake_parse_arguments(call "OUTPUT_QUIET;ERROR_QUIET"
    "RESULT_VARIABLE;TIMEOUT;COMMAND_ECHO" "COMMAND" ${ARGV})
  if(call_COMMAND STREQUAL "sccache;--show-stats")
    if(NOT call_TIMEOUT STREQUAL "30")
      message(FATAL_ERROR "Cache readiness must be bounded")
    endif()
    if(CASE STREQUAL "hit" OR CASE STREQUAL "configure_failure")
      set(result 0)
    elseif(CASE STREQUAL "outage")
      set(result 2)
    elseif(CASE STREQUAL "timeout")
      set(result "Process terminated due to timeout")
    elseif(CASE STREQUAL "missing")
      set(result "No such file or directory")
    else()
      message(FATAL_ERROR "Unknown scenario")
    endif()
  else()
    set(expected "${CMAKE_COMMAND};--preset;ci")
    if(CASE STREQUAL "hit" OR CASE STREQUAL "configure_failure")
      set(launcher sccache)
    else()
      set(launcher "")
    endif()
    list(APPEND expected "-DCMAKE_C_COMPILER_LAUNCHER=${launcher}"
      "-DCMAKE_CXX_COMPILER_LAUNCHER=${launcher}")
    if(NOT call_COMMAND STREQUAL expected)
      message(FATAL_ERROR "Compiler command changed: ${call_COMMAND}")
    endif()
    set_property(GLOBAL PROPERTY configure_was_called true)
    if(CASE STREQUAL "configure_failure")
      set(result 7)
    else()
      set(result 0)
    endif()
  endif()
  set(${call_RESULT_VARIABLE} "${result}" PARENT_SCOPE)
endfunction()

set(ENV{GITHUB_OUTPUT} "${TEST_ROOT}/${CASE}.github-output.txt")
include("${CMAKE_CURRENT_LIST_DIR}/../configure-ci.cmake")
get_property(called GLOBAL PROPERTY configure_was_called)
if(NOT called)
  message(FATAL_ERROR "The compiler configuration was skipped")
endif()
file(READ "$ENV{GITHUB_OUTPUT}" output)
if(CASE STREQUAL "hit")
  set(expected "cache_enabled=true\n")
else()
  set(expected "cache_enabled=false\n")
endif()
if(NOT output STREQUAL expected)
  message(FATAL_ERROR "Wrong cache availability receipt: ${output}")
endif()
